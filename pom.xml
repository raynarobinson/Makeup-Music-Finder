<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>rayna.robinson</groupId>
  <artifactId>makeup-music-finder</artifactId>
  <version>1.0.0</version>

  <name>Makeup &amp; Music Finder</name>
  <url>https://github.com/raynarobinson</url>
  <description>
    A JavaFX desktop application that connects makeup products with music recommendations using REST APIs.
  </description>
  <inceptionYear>2026</inceptionYear>

  <scm>
    <connection>scm:git:https://github.com/raynarobinson/Music-Inspired-Makeup-Recommendation-App.git</connection>
    <developerConnection>scm:git:https://github.com/raynarobinson/Music-Inspired-Makeup-Recommendation-App.git</developerConnection>
    <url>https://github.com/raynarobinson/Music-Inspired-Makeup-Recommendation-App</url>
  </scm>

  <properties>

    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.release>17</maven.compiler.release>

    <gson.version>2.10.1</gson.version>
    <openjfx.version>17.0.17</openjfx.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <exec.addResourcesToClasspath>true</exec.addResourcesToClasspath>
    <exec.cleanupDaemonThreads>false</exec.cleanupDaemonThreads>

    <exec.mainClass>cs1302.api/cs1302.api.ApiDriver</exec.mainClass>

  </properties>


  <developers>
    <developer>
      <name>Rayna Robinson</name>
      <url>https://github.com/raynarobinson</url>
    </developer>
  </developers>


  <organization>
    <name>Rayna Robinson</name>
    <url>https://github.com/raynarobinson</url>
  </organization>


  <dependencyManagement>
    <dependencies>

      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx</artifactId>
        <version>${openjfx.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

    </dependencies>
  </dependencyManagement>


  <dependencies>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${openjfx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${openjfx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-web</artifactId>
      <version>${openjfx.version}</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

  </dependencies>


  <build>

    <resources>
      <resource>
        <directory>resources</directory>
      </resource>
    </resources>


    <pluginManagement>

      <plugins>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>

        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>

        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>

        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>

        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>

      </plugins>

    </pluginManagement>


    <plugins>


      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>

        <configuration>

          <compilerArgs>
            <arg>-Xlint:unchecked,rawtypes</arg>
            <arg>-g</arg>
          </compilerArgs>

        </configuration>

      </plugin>


      <plugin>

        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>

        <configuration>

          <executable>java</executable>

          <arguments>

            <argument>-Dprism.order=sw</argument>

            <argument>--module-path</argument>
            <modulepath/>

            <argument>--module</argument>
            <argument>${exec.mainClass}</argument>

          </arguments>

        </configuration>

      </plugin>


    </plugins>

  </build>


</project>
